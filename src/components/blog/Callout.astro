---
type CalloutType = "info" | "tip" | "tldr" | "warning";

interface Props {
	type?: CalloutType;
}

const { type = "info" } = Astro.props;

/* All class strings are literals so Tailwind's scanner can detect them */
const variants: Record<
	CalloutType,
	{ bg: string; border: string; icon: string; label: string; labelClass: string }
> = {
	info: {
		bg: "bg-textColor/5",
		border: "border-textColor/30",
		icon: "ℹ️",
		label: "Note",
		labelClass: "text-textColor",
	},
	tip: {
		bg: "bg-link/5",
		border: "border-link",
		icon: "💡",
		label: "Tip",
		labelClass: "text-link",
	},
	tldr: {
		bg: "bg-accent/5",
		border: "border-accent",
		icon: "⚡",
		label: "TL;DR",
		labelClass: "text-accent",
	},
	warning: {
		bg: "bg-yellow-500/10",
		border: "border-yellow-500",
		icon: "⚠️",
		label: "Warning",
		labelClass: "text-yellow-700 dark:text-yellow-400",
	},
};

const { bg, border, icon, label, labelClass } = variants[type];
---

<aside class:list={["not-prose my-6 rounded-r-md border-l-4 px-4 py-3", border, bg]} role="note">
	<p class:list={["mb-1 text-sm font-semibold", labelClass]}>
		<span aria-hidden="true">{icon} </span>{label}
	</p>
	<div class="text-textColor text-sm">
		<slot />
	</div>
</aside>
