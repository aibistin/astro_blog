---
import { getAllPosts, sortMDByDate, getUniqueTagsWithCount } from "@/data/post";

const allPosts = sortMDByDate(await getAllPosts());
const recentPosts = allPosts.slice(0, 5);
const morePosts = allPosts.slice(5, 15);
const topTags = getUniqueTagsWithCount(allPosts).slice(0, 15);

const currentPath = Astro.url.pathname;
---

<aside class="hidden lg:block" id="post-sidebar">
	<div class="sticky top-20 space-y-5 text-xs">
		<!-- Collapse / expand toggle -->
		<sidebar-toggle>
			<button
				aria-label="Toggle sidebar"
				class="flex items-center gap-1 text-textColor/50 hover:text-accent"
				id="sidebar-toggle-btn"
				type="button"
			>
				<svg
					aria-hidden="true"
					class="h-3 w-3 transition-transform"
					fill="none"
					id="sidebar-chevron"
					stroke="currentColor"
					stroke-width="2"
					viewBox="0 0 24 24"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path d="M15 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
				<span id="sidebar-toggle-label">Collapse</span>
			</button>
		</sidebar-toggle>

		<!-- Sidebar content (collapsible) -->
		<div id="sidebar-content" class="space-y-6">
			<!-- Recent Posts -->
			<nav aria-label="Recent posts">
				<h2 class="mb-2 font-semibold uppercase tracking-wider text-accent-2">Recent Posts</h2>
				<ul class="space-y-2">
					{
						recentPosts.map((post) => (
							<li>
								<a
									aria-current={currentPath.includes(post.slug) ? "page" : false}
									class="block leading-snug text-textColor underline-offset-2 hover:text-accent hover:underline aria-[current=page]:font-semibold aria-[current=page]:text-accent"
									data-astro-prefetch
									href={`/posts/${post.slug}/`}
								>
									{post.data.title}
								</a>
							</li>
						))
					}
				</ul>

				{
					morePosts.length > 0 && (
						<more-posts-toggle>
							<div class="mt-2 hidden space-y-2" id="more-posts-list">
								<ul class="space-y-2">
									{morePosts.map((post) => (
										<li>
											<a
												class="block leading-snug text-textColor underline-offset-2 hover:text-accent hover:underline"
												data-astro-prefetch
												href={`/posts/${post.slug}/`}
											>
												{post.data.title}
											</a>
										</li>
									))}
								</ul>
							</div>
							<button
								class="mt-2 text-accent hover:underline"
								id="show-more-btn"
								type="button"
							>
								Show older posts ↓
							</button>
						</more-posts-toggle>
					)
				}
			</nav>

			<!-- Tags -->
			{
				topTags.length > 0 && (
					<nav aria-label="Post tags">
						<h2 class="mb-2 font-semibold uppercase tracking-wider text-accent-2">Tags</h2>
						<ul class="flex flex-wrap gap-1">
							{topTags.map(([tag, count]) => (
								<li>
									<a
										class="inline-block rounded border border-textColor/20 px-1.5 py-0.5 text-textColor hover:border-accent/40 hover:text-accent"
										href={`/tags/${tag}/`}
									>
										{tag}{" "}
										<span class="text-textColor/50">({count})</span>
									</a>
								</li>
							))}
						</ul>
					</nav>
				)
			}
		</div>
	</div>
</aside>

<script>
	class MorePostsToggle extends HTMLElement {
		connectedCallback() {
			const btn = this.querySelector<HTMLButtonElement>("#show-more-btn");
			const list = this.querySelector<HTMLDivElement>("#more-posts-list");
			if (!btn || !list) return;

			btn.addEventListener("click", () => {
				const isNowHidden = list.classList.toggle("hidden");
				btn.textContent = isNowHidden ? "Show older posts ↓" : "Show fewer posts ↑";
			});
		}
	}

	class SidebarToggle extends HTMLElement {
		connectedCallback() {
			const btn = this.querySelector<HTMLButtonElement>("#sidebar-toggle-btn");
			const label = document.getElementById("sidebar-toggle-label");
			const chevron = document.getElementById("sidebar-chevron");
			const content = document.getElementById("sidebar-content");
			if (!btn || !label || !content) return;

			// Restore persisted preference
			if (localStorage.getItem("sidebar-collapsed") === "true") {
				content.classList.add("hidden");
				label.textContent = "Expand";
				if (chevron) chevron.style.transform = "rotate(180deg)";
			}

			btn.addEventListener("click", () => {
				const isCollapsed = content.classList.toggle("hidden");
				label.textContent = isCollapsed ? "Expand" : "Collapse";
				if (chevron) chevron.style.transform = isCollapsed ? "rotate(180deg)" : "";
				localStorage.setItem("sidebar-collapsed", isCollapsed.toString());
			});
		}
	}

	customElements.define("more-posts-toggle", MorePostsToggle);
	customElements.define("sidebar-toggle", SidebarToggle);
</script>
